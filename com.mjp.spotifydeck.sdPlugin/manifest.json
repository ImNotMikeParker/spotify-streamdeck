{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Spotify Deck",
  "Version": "1.0.0.0",
  "Author": "Mike Parker",
  "Description": "Fast, live Spotify control for Stream Deck and Stream Deck +. Album art on keys, now-playing on the touch strip, volume and scrub dials, like/shuffle/repeat with live state, playlists and device switching. Spotify Premium required for playback control.",
  "Category": "Spotify Deck",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "UUID": "com.mjp.spotifydeck",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "Name": "Play / Pause",
      "UUID": "com.mjp.spotifydeck.play-pause",
      "Icon": "imgs/actions/play-pause/icon",
      "Tooltip": "Toggle playback. Shows album art with the current state. Long-press for a secondary action.",
      "PropertyInspectorPath": "ui/play-pause.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/play-pause/key",
          "Name": "Toggle"
        }
      ]
    },
    {
      "Name": "Now Playing",
      "UUID": "com.mjp.spotifydeck.now-playing",
      "Icon": "imgs/actions/now-playing/icon",
      "Tooltip": "Album art plus track and artist, always live. Press and long-press actions are configurable.",
      "PropertyInspectorPath": "ui/now-playing.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/now-playing/key"
        }
      ]
    },
    {
      "Name": "Next Track",
      "UUID": "com.mjp.spotifydeck.next",
      "Icon": "imgs/actions/next/icon",
      "Tooltip": "Skip to the next track.",
      "PropertyInspectorPath": "ui/simple.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/next/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Previous Track",
      "UUID": "com.mjp.spotifydeck.previous",
      "Icon": "imgs/actions/previous/icon",
      "Tooltip": "Restart the current track, or go to the previous one if you are near the start (like the Spotify app).",
      "PropertyInspectorPath": "ui/previous.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/previous/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Like",
      "UUID": "com.mjp.spotifydeck.like",
      "Icon": "imgs/actions/like/icon",
      "Tooltip": "Save or remove the current track from Liked Songs. The heart fills live when a track is already liked.",
      "PropertyInspectorPath": "ui/like.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/like/key",
          "Name": "Toggle",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/like/key",
          "Name": "Like"
        },
        {
          "Image": "imgs/actions/like/key",
          "Name": "Unlike"
        }
      ]
    },
    {
      "Name": "Shuffle",
      "UUID": "com.mjp.spotifydeck.shuffle",
      "Icon": "imgs/actions/shuffle/icon",
      "Tooltip": "Toggle shuffle. Lights up when shuffle is on.",
      "PropertyInspectorPath": "ui/simple.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/shuffle/key",
          "Name": "Toggle",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/shuffle/key",
          "Name": "On"
        },
        {
          "Image": "imgs/actions/shuffle/key",
          "Name": "Off"
        }
      ]
    },
    {
      "Name": "Repeat",
      "UUID": "com.mjp.spotifydeck.repeat",
      "Icon": "imgs/actions/repeat/icon",
      "Tooltip": "Cycle repeat: off, all, one. Shows the current mode live.",
      "PropertyInspectorPath": "ui/simple.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/actions/repeat/key",
          "Name": "Cycle",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/repeat/key",
          "Name": "Off"
        },
        {
          "Image": "imgs/actions/repeat/key",
          "Name": "All"
        },
        {
          "Image": "imgs/actions/repeat/key",
          "Name": "One"
        }
      ]
    },
    {
      "Name": "Volume",
      "UUID": "com.mjp.spotifydeck.volume",
      "Icon": "imgs/actions/volume/icon",
      "Tooltip": "Volume up, down, mute or set to a fixed level. Shows the current volume live.",
      "PropertyInspectorPath": "ui/volume.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/volume/key"
        }
      ]
    },
    {
      "Name": "Seek",
      "UUID": "com.mjp.spotifydeck.seek",
      "Icon": "imgs/actions/seek/icon",
      "Tooltip": "Jump forward or backward by a number of seconds.",
      "PropertyInspectorPath": "ui/seek.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/seek/key"
        }
      ]
    },
    {
      "Name": "Play Playlist / URI",
      "UUID": "com.mjp.spotifydeck.play-uri",
      "Icon": "imgs/actions/play-uri/icon",
      "Tooltip": "Start one of your playlists (picked from a list) or any Spotify link/URI: playlist, album, artist, track, podcast.",
      "PropertyInspectorPath": "ui/play-uri.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/play-uri/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Add to Playlist",
      "UUID": "com.mjp.spotifydeck.add-to-playlist",
      "Icon": "imgs/actions/add-to-playlist/icon",
      "Tooltip": "Add the current track to a playlist you choose. Skips duplicates.",
      "PropertyInspectorPath": "ui/add-to-playlist.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/add-to-playlist/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Playback Device",
      "UUID": "com.mjp.spotifydeck.device",
      "Icon": "imgs/actions/device/icon",
      "Tooltip": "Move playback to a specific device (this PC, phone, speaker...). Highlights when that device is active.",
      "PropertyInspectorPath": "ui/device.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/actions/device/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Now Playing (Dial)",
      "UUID": "com.mjp.spotifydeck.dial-now-playing",
      "Icon": "imgs/actions/now-playing/icon",
      "Tooltip": "Stream Deck + dial: album art, track, artist and progress on the touch strip. Rotate for volume or scrubbing, press for play/pause, tap for next, long tap for like.",
      "PropertyInspectorPath": "ui/dial-now-playing.html",
      "Controllers": [
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "layouts/now-playing.json",
        "Icon": "imgs/actions/now-playing/icon",
        "StackColor": "#1DB954",
        "TriggerDescription": {
          "Rotate": "Volume / scrub",
          "Push": "Play / pause",
          "Touch": "Next track",
          "LongTouch": "Like / unlike"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/now-playing/key"
        }
      ]
    },
    {
      "Name": "Volume (Dial)",
      "UUID": "com.mjp.spotifydeck.dial-volume",
      "Icon": "imgs/actions/volume/icon",
      "Tooltip": "Stream Deck + dial: rotate to change volume, press to mute, tap to play/pause.",
      "PropertyInspectorPath": "ui/dial-volume.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "Icon": "imgs/actions/volume/icon",
        "StackColor": "#1DB954",
        "TriggerDescription": {
          "Rotate": "Volume",
          "Push": "Mute / unmute",
          "Touch": "Play / pause"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/volume/key"
        }
      ]
    },
    {
      "Name": "Scrub (Dial)",
      "UUID": "com.mjp.spotifydeck.dial-seek",
      "Icon": "imgs/actions/seek/icon",
      "Tooltip": "Stream Deck + dial: rotate to scrub through the track, press for play/pause, tap for next, long tap for previous.",
      "PropertyInspectorPath": "ui/dial-seek.html",
      "Controllers": [
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "layouts/now-playing.json",
        "Icon": "imgs/actions/seek/icon",
        "StackColor": "#1DB954",
        "TriggerDescription": {
          "Rotate": "Scrub",
          "Push": "Play / pause",
          "Touch": "Next track",
          "LongTouch": "Previous track"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/seek/key"
        }
      ]
    }
  ]
}